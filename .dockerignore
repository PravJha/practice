# Secrets — must never be baked into any image layer
.env

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Version control
.git/
.gitignore

# IDE
.vscode/
.idea/

